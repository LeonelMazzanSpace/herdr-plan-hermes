# Lines to add to ~/.hermes/.env. Never commit the real file.

# Telegram gateway
TELEGRAM_BOT_TOKEN=<token from @BotFather>
TELEGRAM_ALLOWED_USERS=<your numeric Telegram ID>

# Webhook platform (route herdr-events)
WEBHOOK_ENABLED=true
WEBHOOK_PORT=8644

# herdr bridge skill
HERDR_TG_REPOS=/absolute/path/repo-a:/absolute/path/repo-b
HERDR_TG_WEBHOOK_URL=http://127.0.0.1:8644/webhooks/herdr-events
HERDR_TG_SECRET_FILE=/home/<you>/.config/herdr-telegram/webhook.secret
# Permission mode you approve for the orchestrator. Never a bypass mode.
HERDR_TG_PERMISSION_MODE=auto
